# Database Connection
# For Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# For Vercel Production Deployment (PostgreSQL from Vercel Postgres, Neon, Supabase, or Railway):
# DATABASE_URL="postgres://user:password@ep-xyz.us-east-1.aws.neon.tech/lomely?sslmode=require"

# JWT Secret for Session Cookies
JWT_SECRET="lomely-hyper-secure-secret-key-production-ready"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Real-Time WebSocket Server URL
# On local single-port development: leave empty to connect to same-origin
# On Vercel: set to your deployed WebSocket signaling instance (e.g. on Render, Railway, or VPS)
# NEXT_PUBLIC_SOCKET_URL="https://lomely-socket.onrender.com"

# Email Credentials (Optional; mock fallback active if neither is set)
# Option A: Resend API (Recommended - fast, modern, free tier 3000/mo)
# RESEND_API_KEY="re_123456789"
# RESEND_FROM="Lomely <onboarding@resend.dev>"

# Option B: Standard SMTP (Gmail, Brevo, AWS SES)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Lomely <no-reply@lomely.app>"
